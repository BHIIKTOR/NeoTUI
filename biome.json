{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      ".editorconfig",
      ".github/**",
      "!apps/**/dist",
      "apps/**",
      "artifacts/**/*.md",
      "bench/**",
      "biome.json",
      "bunfig.toml",
      "docs/**",
      "examples/**",
      "package.json",
      "!packages/**/dist",
      "packages/**",
      "scripts/**",
      "skills/**",
      "tsconfig.base.json",
      "tsconfig.json"
    ]
  }
}
