{
  "name": "@neotui/react",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@neotui/components": "workspace:*",
    "@neotui/core": "workspace:*",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target bun --external @neotui/core --external @neotui/components --external react --external react/jsx-runtime --external react-reconciler --external react-reconciler/constants",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "lint": "bunx @biomejs/biome check src package.json tsconfig.json"
  }
}
